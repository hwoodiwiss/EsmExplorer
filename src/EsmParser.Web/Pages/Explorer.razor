@page "/explore"
@implements IDisposable
@inject PluginExplorerState State
@inject IJSRuntime JS

<PageTitle>Explorer — ESM Explorer</PageTitle>

@if (State.ActivePlugin is not { } plugin)
{
    <div class="alert alert-info mt-3">
        No plugin is loaded. <a href="">Open plugin files</a> to start exploring.
    </div>
}
else
{
    <div class="explorer-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div class="d-flex align-items-center gap-2">
            @if (State.Workspace.Plugins.Count > 1)
            {
                <select class="form-select form-select-sm w-auto" value="@plugin.Name" @onchange="OnPluginSelected">
                    @foreach (PluginFile candidate in State.Workspace.Plugins)
                    {
                        <option value="@candidate.Name">@candidate.Name</option>
                    }
                </select>
            }
            else
            {
                <h5 class="mb-0">@plugin.Name</h5>
            }
            <small class="text-muted font-monospace">@DisplayFormat.Bytes(plugin.Length) · @plugin.Header.Kind</small>
        </div>
        <form class="d-flex align-items-center gap-2" @onsubmit="GoToEnteredAsync">
            <label class="col-form-label-sm mb-0" for="goto-formid">Go to form id</label>
            <input id="goto-formid" class="form-control form-control-sm font-monospace goto-input"
                   placeholder="0004F2B1" maxlength="8" @bind="_goToText" />
            <button type="submit" class="btn btn-outline-primary btn-sm" disabled="@(State.BusyMessage is not null)">Go</button>
        </form>
    </div>

    @if (State.BusyMessage is { } busy)
    {
        <div class="d-flex align-items-center gap-2 my-2">
            <div class="spinner-border spinner-border-sm" role="status"></div>
            <span class="small">@busy</span>
            @if (State.BusyProgress is { } fraction)
            {
                <div class="progress flex-grow-1" style="height: 0.5rem" role="progressbar" aria-valuenow="@((int)(fraction * 100))" aria-valuemin="0" aria-valuemax="100">
                    <div class="progress-bar" style="width: @(((int)(fraction * 100)))%"></div>
                </div>
            }
        </div>
    }

    @if (State.Notice is { } notice)
    {
        <div class="alert alert-warning alert-dismissible py-2 my-2">
            @notice
            <button type="button" class="btn-close" aria-label="Dismiss" @onclick="State.ClearNotice"></button>
        </div>
    }

    @if (_invalidGoTo is { } invalid)
    {
        <div class="alert alert-warning py-2 my-2">"@invalid" is not a valid form id; enter up to 8 hex digits.</div>
    }

    <div class="explorer-layout">
        <div class="explorer-tree">
            <div id="tn-0" class="tree-row @(State.SelectedNode?.Offset == 0 ? "selected" : null)"
                 @onclick="() => State.Select(plugin.HeaderRecord)">
                <span class="chevron"></span>
                <span class="node-sig">TES4</span>
                <span class="node-name">Plugin Header</span>
                <span class="node-extent">@DisplayFormat.Hex(plugin.HeaderRecord.Offset)</span>
            </div>

            @if (State.GetTopLevelError() is { } topError)
            {
                <div class="alert alert-danger m-2 p-2 small font-monospace">@topError.ToString()</div>
            }
            else if (State.GetTopLevel() is not { } topLevel)
            {
                <div class="p-3"><div class="spinner-border spinner-border-sm"></div> Reading top-level groups…</div>
            }
            else
            {
                @foreach (PluginNode node in topLevel)
                {
                    <PluginTreeNode Node="node" State="State" />
                }
            }
        </div>
        <div class="explorer-details">
            <NodeDetails Plugin="plugin" Node="State.SelectedNode" State="State" />
        </div>
    </div>
}

@code {
    private string? _goToText;
    private string? _invalidGoTo;

    protected override void OnInitialized() => State.Changed += StateHasChanged;

    public void Dispose() => State.Changed -= StateHasChanged;

    protected override async Task OnParametersSetAsync() => await State.EnsureTopLevelAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (State.TakePendingScroll() is { } offset)
        {
            try
            {
                await using var ui = await JS.InvokeAsync<IJSObjectReference>("import", "./js/ui.js");
                await ui.InvokeVoidAsync("scrollToId", $"tn-{offset}");
            }
            catch (JSException)
            {
                // Scroll is best-effort; a JS error should not break the component.
            }
        }
    }

    private async Task OnPluginSelected(ChangeEventArgs args)
    {
        if (args.Value is string name && State.Workspace.FindByName(name) is { } plugin)
        {
            State.SetActive(plugin);
            await State.EnsureTopLevelAsync();
        }
    }

    private async Task GoToEnteredAsync()
    {
        _invalidGoTo = null;
        string text = (_goToText ?? string.Empty).Trim().TrimStart('0', 'x', 'X');
        if (!uint.TryParse(
                string.IsNullOrEmpty(text) ? "0" : text,
                System.Globalization.NumberStyles.HexNumber,
                System.Globalization.CultureInfo.InvariantCulture,
                out uint value))
        {
            _invalidGoTo = _goToText;
            return;
        }

        await State.GoToAsync(new FormId(value));
    }
}
