@page "/model"
@using System.Text.Json
@using NifViewer.Blazor
@inject GameDataService GameData
@inject ModelViewerState ViewerState
@inject NifViewerInterop Interop

<PageTitle>Model Viewer — ESM Explorer</PageTitle>

<div class="explorer-header d-flex flex-wrap justify-content-between align-items-center gap-2">
    <div class="d-flex align-items-center gap-2">
        <h5 class="mb-0">Model Viewer</h5>
        @if (GameData.RootName is { } rootName)
        {
            <span class="badge text-bg-secondary" title="Assets are resolved from this folder">@rootName</span>
        }
    </div>
    <div class="d-flex align-items-center gap-2">
        <label class="btn btn-outline-secondary btn-sm mb-0" title="Load a .nif file directly from disk">
            Open .nif…
            <InputFile OnChange="LoadNifFileAsync" accept=".nif" class="d-none" disabled="@_loading" />
        </label>
        <button class="btn btn-outline-primary btn-sm" @onclick="PickDataRootAsync" disabled="@_loading">
            Choose data root…
        </button>
        <span class="data-root-help" tabindex="0" role="note" aria-label="Data root setup instructions">
            <span class="data-root-help-icon">i</span>
            <span class="data-root-help-popover">
                <strong>Data root setup</strong>
                <span>1. Extract the Starfield BA2 files into a resource folder.</span>
                <span>2. Extract Creation Kit <code>ContentResources.zip</code> and copy its <code>Materials</code> folder into the resource folder.</span>
                <span>3. Choose that folder here. Files are read only when needed.</span>
                <a href="https://github.com/hwoodiwiss/EsmParser#preparing-starfield-resources" target="_blank" rel="noopener noreferrer">Open full instructions</a>
            </span>
        </span>
    </div>
</div>

@if (_unsupported)
{
    <div class="alert alert-warning py-2 my-2">
        This browser does not support the File System Access API, which is required to read game
        data folders. Use a Chromium-based browser.
    </div>
}

@if (_status is { } status)
{
    <div class="d-flex align-items-center gap-2 my-2">
        @if (_loading)
        {
            <div class="spinner-border spinner-border-sm" role="status"></div>
        }
        <span class="small">@status</span>
    </div>
}

<div class="card mb-3">
    <div class="card-header">
        <strong>@(_modelName ?? "No model loaded")</strong>
    </div>
    <div class="card-body p-0">
        <NifViewerCanvas @ref="_viewer" />
    </div>
    <div class="card-footer p-2">
        <NifViewerControls Viewer="_viewer" />
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">
        <button class="btn btn-link btn-sm p-0 text-decoration-none" @onclick="() => _structureOpen = !_structureOpen">
            @(_structureOpen ? "▾" : "▸") NIF structure
        </button>
    </div>
    @if (_structureOpen)
    {
        <div class="card-body py-2">
            <NifStructureView Structure="_structure" />
        </div>
    }
</div>

@code {
    private NifViewerCanvas _viewer = default!;
    private JsonElement? _structure;
    private string? _modelName;
    private string? _status;
    private string? _pendingPath;
    private bool _loading;
    private bool _unsupported;
    private bool _structureOpen;

    protected override async Task OnInitializedAsync()
    {
        _unsupported = !await GameData.InitializeAsync();
        _pendingPath = ViewerState.TakeRequest();
        if (_pendingPath is not null)
        {
            _status = GameData.HasRoot
                ? null
                : $"Choose your game Data folder to load '{_pendingPath}'.";
        }
        else if (!_unsupported)
        {
            _status = "Open a record with a MODL field in the explorer and click View, or choose a data root.";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _pendingPath is not null && GameData.HasRoot)
        {
            await LoadModelAsync(_pendingPath);
        }
    }

    private async Task PickDataRootAsync()
    {
        if (_unsupported || !await GameData.PickAsync())
        {
            return;
        }

        if (_pendingPath is not null)
        {
            await LoadModelAsync(_pendingPath);
        }
        else
        {
            _status = $"Data root '{GameData.RootName}' selected.";
        }
    }

    private async Task LoadModelAsync(string modelPath)
    {
        _loading = true;
        _status = $"Loading {modelPath}…";
        StateHasChanged();

        try
        {
            string normalized = modelPath.Replace('\\', '/').TrimStart('/').ToLowerInvariant();
            while (normalized.StartsWith("data/", StringComparison.Ordinal))
            {
                normalized = normalized[5..];
            }
            string[] candidates = normalized.StartsWith("meshes/", StringComparison.Ordinal)
                ? [normalized]
                : [$"meshes/{normalized}", normalized];

            byte[]? nif = null;
            string? found = null;
            foreach (string candidate in candidates)
            {
                _status = $"Searching for {candidate}…";
                StateHasChanged();
                nif = await GameData.ResolveAsync(candidate);
                if (nif is not null)
                {
                    found = candidate;
                    break;
                }
            }

            if (nif is null)
            {
                _status = $"Model not found in '{GameData.RootName}'. Tried: {string.Join(", ", candidates)}.";
                return;
            }

            _pendingPath = null;
            _status = $"Loading {found} and dependencies…";
            await CompleteLoadAsync(found!, nif);
        }
        catch (Exception ex)
        {
            _status = $"Failed to load {modelPath}: {ex.Message}";
        }
        finally
        {
            _loading = false;
            // Loads triggered outside the normal event pipeline (e.g. from
            // OnAfterRenderAsync) don't re-render automatically.
            StateHasChanged();
        }
    }

    private async Task LoadNifFileAsync(InputFileChangeEventArgs e)
    {
        const long MaxNifSize = 256 * 1024 * 1024;
        _loading = true;
        _status = $"Reading {e.File.Name}…";
        StateHasChanged();

        try
        {
            using var buffer = new MemoryStream();
            await using (Stream stream = e.File.OpenReadStream(maxAllowedSize: MaxNifSize))
            {
                await stream.CopyToAsync(buffer);
            }

            await CompleteLoadAsync(e.File.Name, buffer.ToArray());
        }
        catch (Exception ex)
        {
            _status = $"Failed to load {e.File.Name}: {ex.Message}";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    // Shared tail of both load paths: render the NIF (resolving dependencies
    // from the granted data root, if any), parse its structure, and report.
    private async Task CompleteLoadAsync(string name, byte[] nif)
    {
        _modelName = name;
        StateHasChanged();
        NifLoadResult result = await _viewer.LoadNifAsync(name, nif, GameData);
        _structure = await Interop.ParseNifStructureAsync(nif);
        if (result.Missing.Count == 0)
        {
            _status = $"Loaded {name}.";
        }
        else
        {
            string hint = GameData.HasRoot
                ? string.Empty
                : " Choose a data root to resolve external meshes and textures.";
            _status = $"Loaded {name}; {result.Missing.Count} dependencies missing: {string.Join(", ", result.Missing)}.{hint}";
        }
    }
}
