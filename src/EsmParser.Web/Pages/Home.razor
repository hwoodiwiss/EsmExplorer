@page "/"
@implements IDisposable
@inject PluginExplorerState State
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>ESM Explorer</PageTitle>

<h1>Starfield Plugin Explorer</h1>

<p class="text-muted">
    Open a Starfield <code>.esm</code>, <code>.esp</code>, or <code>.esl</code> file to inspect its
    records, groups, and their exact locations in the file data. Files are read in slices on demand,
    so even multi-gigabyte masters open instantly.
</p>

<div class="card mb-4">
    <div class="card-body">
        <label class="form-label fw-bold" for="plugin-file">Plugin file</label>
        <input id="plugin-file" class="form-control" type="file" accept=".esm,.esp,.esl" @ref="_fileInput" @onchange="OnFileSelectedAsync" disabled="@_loading" />
        @if (_loading)
        {
            <div class="mt-3 d-flex align-items-center gap-2">
                <div class="spinner-border spinner-border-sm" role="status"></div>
                <span>Reading plugin header…</span>
            </div>
        }
    </div>
</div>

@if (_interopError is { } interopError)
{
    <div class="alert alert-danger">
        <strong>The browser could not read the file.</strong>
        <div class="font-monospace mt-1">@interopError</div>
    </div>
}

@if (State.LastError is { } error)
{
    <div class="alert alert-danger">
        <strong>Could not open the plugin.</strong>
        <div class="font-monospace mt-1">@error.ToString()</div>
    </div>
}

@if (State.Plugin is { } plugin)
{
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span><strong>@plugin.Name</strong> — @DisplayFormat.Bytes(plugin.Length)</span>
            <a class="btn btn-primary btn-sm" href="explore">Explore records</a>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <table class="table table-sm">
                        <tbody>
                            <tr><th scope="row">Kind</th><td>@plugin.Header.Kind</td></tr>
                            <tr><th scope="row">HEDR version</th><td>@plugin.Header.Version.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)</td></tr>
                            <tr><th scope="row">Form version</th><td>@plugin.Header.RecordHeader.FormVersion</td></tr>
                            <tr><th scope="row">Records + groups</th><td>@plugin.Header.RecordAndGroupCount.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</td></tr>
                            <tr><th scope="row">Next form id</th><td class="font-monospace">@DisplayFormat.Hex(plugin.Header.NextFormId)</td></tr>
                            <tr><th scope="row">Interior cells</th><td>@(plugin.Header.InteriorCellCount?.ToString("N0", System.Globalization.CultureInfo.InvariantCulture) ?? "—")</td></tr>
                            <tr><th scope="row">Overridden forms</th><td>@plugin.Header.OverriddenForms.Count.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</td></tr>
                        </tbody>
                    </table>
                </div>
                <div class="col-md-6">
                    <table class="table table-sm">
                        <tbody>
                            <tr><th scope="row">Author</th><td>@(plugin.Header.Author ?? "—")</td></tr>
                            <tr><th scope="row">Description</th><td>@(plugin.Header.Description ?? "—")</td></tr>
                            <tr>
                                <th scope="row">Header flags</th>
                                <td>
                                    @foreach (string name in plugin.Header.RecordHeader.Flags.GetFlagNames())
                                    {
                                        <span class="badge text-bg-secondary me-1">@name</span>
                                    }
                                </td>
                            </tr>
                            <tr><th scope="row">Timestamp</th><td>@(plugin.Header.RecordHeader.TimestampAsDate?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture) ?? "—")</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            @if (plugin.Header.Masters.Count > 0)
            {
                <h6 class="mt-2">Masters</h6>
                <table class="table table-sm table-striped w-auto">
                    <thead><tr><th>Index</th><th>File</th></tr></thead>
                    <tbody>
                        @foreach (MasterReference master in plugin.Header.Masters)
                        {
                            <tr>
                                <td class="font-monospace">@master.Index.ToString("X2", System.Globalization.CultureInfo.InvariantCulture)</td>
                                <td>@master.FileName</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

@code {
    private ElementReference _fileInput;
    private bool _loading;
    private string? _interopError;

    protected override void OnInitialized() => State.Changed += StateHasChanged;

    public void Dispose() => State.Changed -= StateHasChanged;

    private async Task OnFileSelectedAsync()
    {
        _loading = true;
        _interopError = null;
        try
        {
            BlobDataSource? source = await BlobDataSource.CreateFromInputAsync(JS, _fileInput);
            if (source is null)
            {
                return;
            }

            if (await State.LoadAsync(source))
            {
                Navigation.NavigateTo("explore");
            }
        }
        catch (JSException exception)
        {
            _interopError = exception.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}
