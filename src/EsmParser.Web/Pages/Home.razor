@page "/"
@implements IDisposable
@inject PluginExplorerState State
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject GameDataService GameData

<PageTitle>ESM Explorer</PageTitle>

<h1>Starfield Plugin Explorer</h1>

<p class="text-muted">
    Start by choosing your game's <code>Data</code> folder. Its <code>.esm</code>, <code>.esp</code>, and
    <code>.esl</code> plugins are listed for loading, and the same folder supplies loose files and
    BSA/BA2 archives to the model viewer. Load a plugin together with its masters to follow references
    between files. Files are read in slices on demand, so even multi-gigabyte masters open instantly.
</p>

<div class="card mb-4">
    <div class="card-body">
        <div class="d-flex flex-wrap align-items-center gap-2">
            <span class="fw-bold">Data root</span>
            @if (GameData.RootName is { } rootName)
            {
                <span class="badge text-bg-secondary" title="Plugins and assets are read from this folder">@rootName</span>
            }
            <button class="btn @(GameData.HasRoot ? "btn-outline-primary" : "btn-primary") btn-sm"
                    @onclick="PickDataRootAsync" disabled="@(_loading || _unsupported)">
                @(GameData.HasRoot ? "Change data root…" : "Choose data root…")
            </button>
        </div>
        @if (_rootStatus is { } rootStatus)
        {
            <div class="small mt-2">@rootStatus</div>
        }
        @if (_unsupported)
        {
            <div class="alert alert-warning py-2 mt-3 mb-0">
                This browser does not support the File System Access API, which is required to read a game
                data folder (and to resolve model assets). Use a Chromium-based browser, or open individual
                plugin files below.
            </div>
        }
        @if (GameData.ArchiveErrors.Count > 0)
        {
            <details class="alert alert-warning py-2 mt-3 mb-0">
                <summary>@GameData.ArchiveErrors.Count archive(s) could not be indexed</summary>
                @foreach (string archiveError in GameData.ArchiveErrors)
                {
                    <div>@archiveError</div>
                }
            </details>
        }

        @if (GameData.HasRoot)
        {
            <hr />
            @if (GameData.PluginNames.Count == 0)
            {
                <div class="text-muted">No plugins were found at the top level of this folder.</div>
            }
            else
            {
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    <span class="fw-bold">Plugins (@GameData.PluginNames.Count)</span>
                    <input class="form-control form-control-sm w-auto" aria-label="Filter plugins" placeholder="Filter plugins…"
                           @bind="_pluginFilter" @bind:event="oninput" />
                    <button class="btn btn-outline-secondary btn-sm" @onclick="SelectAllVisible" disabled="@_loading">Select all</button>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => _selected.Clear()" disabled="@_loading">Clear</button>
                    <button class="btn btn-primary btn-sm" @onclick="LoadSelectedAsync" disabled="@(_loading || _selected.Count == 0)">
                        Load selected (@_selected.Count)
                    </button>
                </div>
                <div class="plugin-list" style="max-height: 20rem; overflow-y: auto;">
                    @foreach (string name in VisiblePlugins)
                    {
                        bool loaded = IsLoaded(name);
                        string id = $"plugin-{name}";
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="@id" disabled="@(_loading || loaded)"
                                   checked="@(loaded || _selected.Contains(name))" @onchange="e => Toggle(name, e)" />
                            <label class="form-check-label font-monospace" for="@id">
                                @name
                                @if (loaded)
                                {
                                    <span class="badge text-bg-secondary ms-1">loaded</span>
                                }
                            </label>
                        </div>
                    }
                </div>
            }
        }

        @if (_unsupported)
        {
            <hr />
            <label class="form-label fw-bold" for="plugin-file">Plugin files</label>
            <input id="plugin-file" class="form-control" type="file" multiple accept=".esm,.esp,.esl" @ref="_fileInput" @onchange="OnFilesSelectedAsync" disabled="@_loading" />
        }

        @if (_loading)
        {
            <div class="mt-3 d-flex align-items-center gap-2">
                <div class="spinner-border spinner-border-sm" role="status"></div>
                <span>@(_loadingMessage ?? "Reading plugin headers…")</span>
            </div>
        }
    </div>
</div>

@if (_interopError is { } interopError)
{
    <div class="alert alert-danger">
        <strong>The browser could not read the file.</strong>
        <div class="font-monospace mt-1">@interopError</div>
    </div>
}

@if (State.LastError is { } error)
{
    <div class="alert alert-danger">
        <strong>Could not open a plugin.</strong>
        <div class="font-monospace mt-1">@error.ToString()</div>
    </div>
}

@if (State.Workspace.Plugins.Count > 0)
{
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span><strong>Loaded plugins</strong></span>
            <a class="btn btn-primary btn-sm" href="explore">Open explorer</a>
        </div>
        <div class="card-body">
            <table class="table table-sm align-middle">
                <thead>
                    <tr><th>Plugin</th><th>Size</th><th>Kind</th><th>Author</th><th>Masters</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (PluginFile plugin in State.Workspace.Plugins)
                    {
                        IReadOnlyList<string> missing = State.Workspace.GetMissingMasters(plugin);
                        <tr>
                            <td>
                                <strong>@plugin.Name</strong>
                                @if (ReferenceEquals(State.ActivePlugin, plugin))
                                {
                                    <span class="badge text-bg-primary ms-1">active</span>
                                }
                            </td>
                            <td>@DisplayFormat.Bytes(plugin.Length)</td>
                            <td>@plugin.Header.Kind</td>
                            <td>@(plugin.Header.Author ?? "—")</td>
                            <td>
                                @if (plugin.Header.Masters.Count == 0)
                                {
                                    <span class="text-muted">none</span>
                                }
                                @foreach (MasterReference master in plugin.Header.Masters)
                                {
                                    bool isMissing = missing.Contains(master.FileName);
                                    <span class="badge @(isMissing ? "text-bg-warning" : "text-bg-secondary") me-1"
                                          title="@(isMissing ? "Not loaded: references into this master cannot be followed" : "Loaded")">
                                        @master.FileName
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                <button class="btn btn-outline-primary btn-sm" @onclick="() => ExploreAsync(plugin)">Explore</button>
                                <button class="btn btn-outline-danger btn-sm" @onclick="() => State.RemoveAsync(plugin)">Remove</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private ElementReference _fileInput;
    private readonly HashSet<string> _selected = new(StringComparer.OrdinalIgnoreCase);
    private string _pluginFilter = string.Empty;
    private bool _loading;
    private bool _unsupported;
    private string? _loadingMessage;
    private string? _rootStatus;
    private string? _interopError;

    private IEnumerable<string> VisiblePlugins =>
        GameData.PluginNames.Where(name => name.Contains(_pluginFilter, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        State.Changed += StateHasChanged;
        _unsupported = !await GameData.InitializeAsync();
    }

    public void Dispose() => State.Changed -= StateHasChanged;

    private bool IsLoaded(string name) =>
        State.Workspace.Plugins.Any(plugin => string.Equals(plugin.Name, name, StringComparison.OrdinalIgnoreCase));

    private void Toggle(string name, ChangeEventArgs e)
    {
        if (e.Value is true)
        {
            _selected.Add(name);
        }
        else
        {
            _selected.Remove(name);
        }
    }

    private void SelectAllVisible()
    {
        foreach (string name in VisiblePlugins.Where(name => !IsLoaded(name)))
        {
            _selected.Add(name);
        }
    }

    private async Task PickDataRootAsync()
    {
        _loading = true;
        _loadingMessage = "Choose a Data folder; indexing archives…";
        _interopError = null;
        try
        {
            if (!await GameData.PickAsync())
            {
                _rootStatus = "Folder selection cancelled.";
                return;
            }
            _selected.Clear();
            _rootStatus = $"Data root '{GameData.RootName}' selected; {GameData.PluginNames.Count} plugins found, {GameData.ArchiveCount} archives indexed.";
        }
        catch (Exception ex) when (ex is JSException or IOException)
        {
            _rootStatus = $"Could not select data root: {ex.Message}";
        }
        finally
        {
            _loading = false;
            _loadingMessage = null;
        }
    }

    private async Task LoadSelectedAsync()
    {
        _loading = true;
        _loadingMessage = null;
        _interopError = null;
        var sources = new List<DataRootDataSource>();
        try
        {
            foreach (string name in GameData.PluginNames.Where(name => _selected.Contains(name) && !IsLoaded(name)))
            {
                if (await GameData.OpenPluginAsync(name) is { } source)
                {
                    sources.Add(source);
                }
                else
                {
                    _interopError = $"'{name}' is no longer available in the data root.";
                }
            }
            if (sources.Count > 0)
            {
                await State.AddSourcesAsync(sources);
            }
            _selected.Clear();
        }
        catch (IOException exception)
        {
            _interopError = exception.Message;
            foreach (DataRootDataSource source in sources)
            {
                await source.DisposeAsync();
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnFilesSelectedAsync()
    {
        _loading = true;
        _interopError = null;
        try
        {
            IReadOnlyList<BlobDataSource> sources = await BlobDataSource.CreateAllFromInputAsync(JS, _fileInput);
            if (sources.Count > 0)
            {
                await State.AddSourcesAsync(sources);
            }
        }
        catch (JSException exception)
        {
            _interopError = exception.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private Task ExploreAsync(PluginFile plugin)
    {
        State.SetActive(plugin);
        Navigation.NavigateTo("explore");
        return Task.CompletedTask;
    }
}