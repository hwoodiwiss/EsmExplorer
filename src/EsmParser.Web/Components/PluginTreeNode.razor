@* One node in the lazily-expanded plugin tree. Groups load their children on first expansion. *@

<div class="tree-row @(IsSelected ? "selected" : null)"
     style="padding-left:@(Node.Depth * 16 + 4)px"
     @onclick="SelectAsync">
    @if (Node is GroupNode group)
    {
        <span class="chevron" @onclick="ToggleAsync" @onclick:stopPropagation="true">@(_expanded ? "▾" : "▸")</span>
        <span class="node-sig">@group.Header.GetLabelDescription()</span>
        <span class="node-name">@GroupKindLabel(group)</span>
        <span class="node-extent">@DisplayFormat.Bytes(group.TotalSize)</span>
    }
    else if (Node is RecordNode record)
    {
        <span class="chevron"></span>
        <span class="node-sig">@record.Header.Signature.ToString()</span>
        <span class="node-formid">@record.Header.FormId.ToString()</span>
        @if (record.TypeName is { } typeName)
        {
            <span class="node-name">@typeName</span>
        }
        @if (record.IsCompressed)
        {
            <span class="badge text-bg-info node-badge">zlib</span>
        }
        @if (record.Header.IsDeleted)
        {
            <span class="badge text-bg-danger node-badge">deleted</span>
        }
    }
</div>

@if (_expanded)
{
    @if (_childrenError is { } error)
    {
        <div class="alert alert-danger m-2 p-2 small font-monospace">@error.ToString()</div>
    }
    else if (_children is null)
    {
        <div class="tree-loading" style="padding-left:@((Node.Depth + 1) * 16 + 4)px">
            <div class="spinner-border spinner-border-sm"></div> loading…
        </div>
    }
    else
    {
        @foreach (PluginNode child in _children.Take(_visibleCount))
        {
            <PluginTreeNode Node="child" State="State" />
        }
        @if (_children.Count > _visibleCount)
        {
            <button class="btn btn-link btn-sm show-more" style="margin-left:@((Node.Depth + 1) * 16 + 4)px" @onclick="ShowMore">
                Show @Math.Min(PageSize, _children.Count - _visibleCount) more of @(_children.Count - _visibleCount) remaining…
            </button>
        }
    }
}

@code {
    private const int PageSize = 500;

    private bool _expanded;
    private IReadOnlyList<PluginNode>? _children;
    private ParseError? _childrenError;
    private int _visibleCount = PageSize;

    [Parameter, EditorRequired]
    public required PluginNode Node { get; set; }

    [Parameter, EditorRequired]
    public required PluginExplorerState State { get; set; }

    private bool IsSelected => ReferenceEquals(State.SelectedNode, Node);

    private static string GroupKindLabel(GroupNode group) => group.Header.GroupType switch
    {
        GroupType.Top => KnownRecordTypes.GetNameOrDefault(group.Header.LabelAsSignature) ?? "Top Group",
        _ => group.Header.GroupType.ToString(),
    };

    private async Task SelectAsync()
    {
        State.Select(Node);
        if (Node is GroupNode && !_expanded)
        {
            await ToggleAsync();
        }
    }

    private async Task ToggleAsync()
    {
        _expanded = !_expanded;
        if (_expanded && _children is null && _childrenError is null && Node is GroupNode group && State.Plugin is { } plugin)
        {
            ParseResult<IReadOnlyList<PluginNode>> result = await plugin.GetChildrenAsync(group);
            if (!result.TryGet(out IReadOnlyList<PluginNode>? children, out ParseError? error))
            {
                _childrenError = error;
                return;
            }

            _children = children;
        }
    }

    private void ShowMore() => _visibleCount += PageSize;
}
