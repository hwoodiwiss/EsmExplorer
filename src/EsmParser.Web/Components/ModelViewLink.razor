@* A "View" action for model paths (MODL fields): hands the path to the model viewer page. *@
@inject ModelViewerState ViewerState
@inject NavigationManager Navigation

<a class="formid-link small ms-2" href="model" title="View @Path in the model viewer"
   @onclick="View" @onclick:preventDefault="true">View</a>

@code {
    [Parameter, EditorRequired]
    public required string Path { get; set; }

    private void View()
    {
        ViewerState.Request(Path);
        Navigation.NavigateTo("model");
    }
}
