<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <RootNamespace>EsmParser.Core.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- CA1707: underscore-separated test names are the convention for readable test output. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EsmParser.Core\EsmParser.Core.csproj" />
  </ItemGroup>

</Project>
